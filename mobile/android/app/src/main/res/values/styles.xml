<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The launch screen: Android 12+ draws the logo on the app's background; older versions show
         drawable/launch.xml. Compose (MainActivity) then draws everything with Material 3. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
